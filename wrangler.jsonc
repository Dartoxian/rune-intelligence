{
  // Static-assets-only Worker: no server-side code, so no "main".
  // "not_found_handling": "none" because this app has no client-side router —
  // unknown paths should 404 rather than serve index.html.
  "name": "rune-intelligence",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  }
}
